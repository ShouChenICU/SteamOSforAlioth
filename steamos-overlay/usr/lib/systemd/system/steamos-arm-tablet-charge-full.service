[Unit]
Description=Lenovo tablets: charge to full (drop the limit Android leaves)
ConditionFirmware=|device-tree-compatible(lenovo,tb321fu)
ConditionFirmware=|device-tree-compatible(lenovo,elden)
ConditionFirmware=|device-tree-compatible(lenovo,baldur)
Before=upower.service

[Service]
Type=oneshot
ExecStart=/usr/lib/steamos-arm/tablet-charge-full

[Install]
WantedBy=multi-user.target
