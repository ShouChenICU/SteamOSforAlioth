[Unit]
Description=Steam's performance profile, TDP, GPU clock and charge limit for this handheld
# Before the session's steamos-manager reads its remotes.d.
Before=display-manager.service
After=dbus.service

[Service]
Type=dbus
BusName=org.steamos_arm.Power
ExecStart=/usr/lib/steamos-arm/steamos-arm-power
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
