[Unit]
# Only the player's session: a root login (SSH, the updater) starts a
# user manager for root too, which ran these as root every time.
ConditionUser=!root
Description=SM8550 Plasma Wayland environment
DefaultDependencies=no
Before=plasma-core.target plasma-workspace.target plasma-workspace-wayland.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/steamos/sm8550-prepare-plasma
