[Unit]
# Only the player's session: a root login (SSH, the updater) starts a
# user manager for root too, which ran these as root every time.
ConditionUser=!root
Description=SM8550 speaker / HDMI-DP sink policy
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
ExecStart=/usr/lib/steamos/sm8550-audio-pipewire --watch
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
