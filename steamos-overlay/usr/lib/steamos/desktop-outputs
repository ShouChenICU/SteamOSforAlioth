#!/usr/bin/env python3
"""desktop-outputs: KWin screen layout for this handheld, before Plasma starts.

The DSI panels are mounted sideways and have no EDID. Older images shipped one
fixed kwinoutputconfig.json (DSI-1, Rotated270, 1080x1920), which is right
for panels with DT `rotation = <90>` (Pocket FIT, Odin 2, Thor) but upside
down on the ones mounted the other way (Retroid Pocket 6, Odin 2 Portal, the
AYANEO DS / EVO / DMG), and wrong on dual-screen devices.

This writes ~/.config/kwinoutputconfig.json from what is connected:
  - transform from the connector's "panel orientation" (DT rotation),
  - scale by panel size (1.25 on 1080p-class panels, like before),
  - a second panel (AYN Thor, AYANEO Pocket DS) placed under the main one,
  - each touchscreen tied to its own panel in kcminputrc.

It only replaces a file it wrote itself (or the old fixed one); once you
change the layout in System Settings, it leaves it alone.
"""
from __future__ import annotations

import hashlib
import json
import os
import re
import subprocess
import sys
from pathlib import Path

HOME = Path(os.environ.get("HOME", "/home/steamos"))
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
KWIN_OUTPUTS = CONFIG / "kwinoutputconfig.json"
KCMINPUT = CONFIG / "kcminputrc"
STAMP = CONFIG / "steamos-arm" / "desktop-outputs.sha256"
LEGACY = Path("/usr/share/steamos-arm/kwinoutputconfig.legacy.json")

# DRM "panel orientation" -> KWin transform. right-up is what DT rotation 90
# gives; the old fixed file used Rotated270 for it and that is verified.
TRANSFORM = {"normal": "Normal", "upside-down": "Rotated180",
             "left-up": "Rotated90", "right-up": "Rotated270"}

# Second-panel touchscreens by model (same names gamescope-session ignores).
SECONDARY_TOUCH = {
    "AYN Thor": "bottom_touchscreen",
    "AYN Thor Lite": "bottom_touchscreen",
    "AYANEO Pocket DS": "Goodix Capacitive TouchScreen",
}


def log(msg: str) -> None:
    print(f"desktop-outputs: {msg}", file=sys.stderr, flush=True)


def model() -> str:
    try:
        return Path("/sys/firmware/devicetree/base/model").read_text().rstrip("\0\n")
    except OSError:
        return ""


def panels() -> list[dict]:
    out = subprocess.run(["/usr/lib/steamos/panel-modes", "--json"],
                         capture_output=True, text=True, timeout=10)
    if out.returncode != 0:
        return []
    return json.loads(out.stdout or "[]")


def transform(p: dict) -> str:
    t = TRANSFORM.get(p["orientation"])
    if t:
        return t
    # No orientation property: a portrait panel in a landscape handheld,
    # same guess gamescope makes.
    return "Rotated270" if p["width"] < p["height"] else "Normal"


def scale(p: dict) -> float:
    short = min(p["width"], p["height"])
    if short >= 1400:
        return 1.5
    if short >= 1000:
        return 1.25
    return 1.0


def logical(p: dict) -> tuple[int, int]:
    w, h = p["width"], p["height"]
    if transform(p) in ("Rotated90", "Rotated270"):
        w, h = h, w
    s = scale(p)
    return round(w / s), round(h / s)


def output_entry(p: dict) -> dict:
    # 60 Hz on the desktop like before (less power); Game Mode picks its own.
    rate = 60 if 60 in p["rates"] or not p["rates"] else max(p["rates"])
    return {
        "allowSdrSoftwareBrightness": True,
        "autoRotation": "InTabletMode",
        "brightness": 1,
        "colorProfileSource": "sRGB",
        "connectorName": p["name"],
        "edidIdentifier": "",
        "highDynamicRange": False,
        "iccProfilePath": "",
        "mode": {"height": p["height"], "refreshRate": rate * 1000, "width": p["width"]},
        "overscan": 0,
        "rgbRange": "Automatic",
        "scale": scale(p),
        "sdrBrightness": 200,
        "sdrGamutWideness": 0,
        "transform": transform(p),
        "vrrPolicy": "Automatic",
        "wideColorGamut": False,
    }


def build(found: list[dict]) -> list:
    # Main panel = the biggest, same pick as gamescope-session.
    found = sorted(found, key=lambda p: p["width"] * p["height"], reverse=True)
    main = found[0]
    mw, mh = logical(main)
    setup = [{"enabled": True, "outputIndex": 0, "position": {"x": 0, "y": 0}, "priority": 0}]
    for i, p in enumerate(found[1:], start=1):
        w, _ = logical(p)
        setup.append({"enabled": True, "outputIndex": i,
                      "position": {"x": max(0, (mw - w) // 2), "y": mh}, "priority": i})
    return [
        {"data": [output_entry(p) for p in found], "name": "outputs"},
        {"data": [{"lidClosed": False, "outputs": setup}], "name": "setups"},
    ]


def touchscreens() -> list[tuple[str, int, int]]:
    """(name, vendor, product) of direct-touch input devices."""
    out = []
    try:
        text = Path("/proc/bus/input/devices").read_text(errors="replace")
    except OSError:
        return out
    for block in text.split("\n\n"):
        m_id = re.search(r"Vendor=([0-9a-f]{4}) Product=([0-9a-f]{4})", block)
        m_name = re.search(r'N: Name="([^"]*)"', block)
        m_prop = re.search(r"B: PROP=([0-9a-f]+)", block)
        m_abs = re.search(r"B: ABS=([0-9a-f ]+)", block)
        if not (m_id and m_name and m_prop and m_abs):
            continue
        direct = int(m_prop.group(1), 16) & 0x2
        absbits = int(m_abs.group(1).split()[-1], 16)
        if direct and absbits & (1 << 0x35):      # INPUT_PROP_DIRECT + ABS_MT_POSITION_X
            out.append((m_name.group(1), int(m_id.group(1), 16), int(m_id.group(2), 16)))
    return out


def map_touch(found: list[dict]) -> None:
    """Tie each touchscreen to its panel ([Libinput][vid][pid][name] OutputName)."""
    if len(found) < 2:
        return
    ordered = sorted(found, key=lambda p: p["width"] * p["height"], reverse=True)
    main, second = ordered[0]["name"], ordered[1]["name"]
    secondary = SECONDARY_TOUCH.get(model())
    groups, seen, dupes = {}, set(), set()
    for name, vid, pid in touchscreens():
        key = f"[Libinput][{vid}][{pid}][{name}]"
        if key in seen:
            dupes.add(key)
        seen.add(key)
        groups[key] = second if name == secondary else main
    # KWin can only tell touchscreens apart by vid/pid/name. On the 7.0.14
    # kernel both Thor touchscreens are "generic ft5x06 (8d)", so one entry
    # tied both to the top panel: bottom-screen touches landed up there from
    # the second Desktop session on. Leave those to KWin's own default (what
    # the first session used) and drop what an older run wrote for them.
    for key in dupes:
        groups[key] = None
        log(f"touch: two touchscreens share {key}, leaving them to KWin")
    if not groups:
        return
    lines = KCMINPUT.read_text().splitlines() if KCMINPUT.exists() else []
    kept, skip = [], False
    for line in lines:
        if line.startswith("["):
            skip = line.strip() in groups
        if not skip:
            kept.append(line)
    while kept and not kept[-1].strip():
        kept.pop()
    for group, output in groups.items():
        if output is not None:
            kept += ["", group, f"OutputName={output}"]
    KCMINPUT.write_text("\n".join(kept).lstrip("\n") + "\n")
    log("touch: " + ", ".join(f"{g.split('][')[-1][:-1]} -> {o or 'KWin default'}"
                              for g, o in groups.items()))


def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest() if path.exists() else ""


def seeded_upside_down(found: list[dict]) -> bool:
    """A layout desktop-fit seeded from the old fixed file before 1.3.1.

    On the first Desktop start desktop-fit ran before this and copied the
    old fixed file (Rotated270) to set the scale, so the file matched
    neither our stamp nor the legacy copy and was kept as the user's: the
    Retroid Pocket 6, Odin 2 Portal and AYANEO DS / EVO / DMG stayed upside
    down. Without our stamp, every panel still at Rotated270 while this
    panel needs something else can only be that seed; a layout rotated by
    hand in System Settings has another transform and is kept.
    """
    if STAMP.exists() or all(transform(p) == "Rotated270" for p in found):
        return False
    try:
        outputs = next(s["data"] for s in json.loads(KWIN_OUTPUTS.read_text())
                       if s.get("name") == "outputs")
    except (OSError, ValueError, StopIteration, KeyError, TypeError):
        return False
    return bool(outputs) and all(o.get("transform") == "Rotated270" for o in outputs)


def main() -> int:
    found = panels()
    if not found:
        log("no panels found, leaving KWin's config alone")
        return 0
    current = digest(KWIN_OUTPUTS)
    ours = STAMP.read_text().strip() if STAMP.exists() else ""
    legacy = digest(LEGACY) if LEGACY.exists() else ""
    if current and current not in (ours, legacy):
        if seeded_upside_down(found):
            log("kwinoutputconfig.json is the old Rotated270 seed, not the user's: replacing it")
        else:
            log("kwinoutputconfig.json was changed by the user, keeping it")
            return 0
    data = json.dumps(build(found), indent=4) + "\n"
    CONFIG.mkdir(parents=True, exist_ok=True)
    tmp = KWIN_OUTPUTS.with_suffix(".tmp")
    tmp.write_text(data)
    os.replace(tmp, KWIN_OUTPUTS)
    STAMP.parent.mkdir(parents=True, exist_ok=True)
    STAMP.write_text(digest(KWIN_OUTPUTS) + "\n")
    log("wrote " + ", ".join(f"{p['name']} {p['width']}x{p['height']} {transform(p)} x{scale(p)}"
                             for p in found))
    map_touch(found)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:          # never block Plasma from starting
        log(f"failed: {exc}")
        sys.exit(0)
