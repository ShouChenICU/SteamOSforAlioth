# Y700 Gen 4: Steam's brightness slider goes through gamescope, which runs as
# the user. The base image only opens the DSI backlights to the video group.
SUBSYSTEM=="backlight", KERNEL=="aw99706-backlight", RUN+="/bin/chgrp video /sys/class/backlight/%k/brightness", RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness"
