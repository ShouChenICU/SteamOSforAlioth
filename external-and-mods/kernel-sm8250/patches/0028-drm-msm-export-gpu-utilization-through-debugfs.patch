drm/msm: export GPU utilization through debugfs

A performance overlay running in the compositor has no way to ask how busy
the GPU is. The DRM fdinfo engine times are per-client, so an overlay that
reads them accounts only for its own submissions -- gamescope's mangoapp
reports 0% GPU load while a game renders at full tilt -- and msm has no
equivalent of amdgpu's system-wide gpu_busy_percent.

The number is already there: a6xx_gpu_busy() feeds the devfreq governor a
monotonic busy-cycle counter. The governor consumes its own samples, so add
a second mark and a debugfs file over it.

Named perf_now at the DRM minor's debugfs root, because that is where
MangoHud's msm backend looks for it.

--- a/drivers/gpu/drm/msm/msm_debugfs.c
+++ b/drivers/gpu/drm/msm/msm_debugfs.c
@@ -357,6 +357,32 @@
 	return ret;
 }
 
+/*
+ * Utilization of the whole GPU, as a percentage.  Userspace performance
+ * overlays need a system-wide figure: the DRM fdinfo engine times are
+ * per-client, so an overlay living in the compositor only ever sees its own
+ * submissions and reports an idle GPU while a game is rendering.
+ */
+static int msm_gpu_perf_now_show(struct seq_file *m, void *arg)
+{
+	struct drm_device *dev = m->private;
+	struct msm_drm_private *priv = dev->dev_private;
+	struct msm_gpu *gpu = priv->gpu;
+	int load;
+
+	if (!gpu)
+		return -ENODEV;
+
+	load = msm_devfreq_get_load(gpu);
+	if (load < 0)
+		return load;
+
+	seq_printf(m, "%d\n", load);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(msm_gpu_perf_now);
+
 static void msm_debugfs_gpu_init(struct drm_minor *minor)
 {
 	struct drm_device *dev = minor->dev;
@@ -366,6 +392,9 @@
 	debugfs_create_file("gpu", S_IRUSR, minor->debugfs_root,
 		dev, &msm_gpu_fops);
 
+	debugfs_create_file("perf_now", 0444, minor->debugfs_root,
+		dev, &msm_gpu_perf_now_fops);
+
 	debugfs_create_u32("hangcheck_period_ms", 0600, minor->debugfs_root,
 		&priv->hangcheck_period);
 
