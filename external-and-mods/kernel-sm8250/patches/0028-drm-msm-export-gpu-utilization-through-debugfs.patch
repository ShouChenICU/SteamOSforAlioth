--- a/drivers/gpu/drm/msm/msm_gpu_devfreq.c
+++ b/drivers/gpu/drm/msm/msm_gpu_devfreq.c
@@ -119,6 +119,54 @@
 	return 0;
 }
 
+/**
+ * msm_devfreq_get_load() - percentage of wall time the GPU was busy
+ *
+ * Returns how busy the GPU was between this call and the previous one, or a
+ * negative errno if the counter is unavailable.  Nothing else in the driver
+ * exposes this: msm has no equivalent of amdgpu's gpu_busy_percent, and the
+ * DRM fdinfo engine times only ever account for one client's submissions.
+ */
+int msm_devfreq_get_load(struct msm_gpu *gpu)
+{
+	struct msm_gpu_devfreq *df = &gpu->devfreq;
+	u64 busy_cycles, busy_time, total_time;
+	unsigned long sample_rate;
+	ktime_t time;
+
+	if (!gpu->funcs->gpu_busy)
+		return -ENODEV;
+
+	mutex_lock(&df->lock);
+
+	time = ktime_get();
+	total_time = ktime_us_delta(time, df->load_time);
+	df->load_time = time;
+
+	/*
+	 * gpu_busy() may only be called while the GPU is powered, and a
+	 * suspended GPU is by definition not busy.
+	 */
+	if (df->suspended) {
+		mutex_unlock(&df->lock);
+		return 0;
+	}
+
+	busy_cycles = gpu->funcs->gpu_busy(gpu, &sample_rate);
+	busy_time = busy_cycles - df->load_busy_cycles;
+	df->load_busy_cycles = busy_cycles;
+
+	mutex_unlock(&df->lock);
+
+	if (!total_time)
+		return 0;
+
+	busy_time *= USEC_PER_SEC;
+	busy_time = div64_ul(busy_time, sample_rate);
+
+	return min_t(u64, div64_u64(busy_time * 100, total_time), 100);
+}
+
